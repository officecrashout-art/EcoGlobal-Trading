# Eco Global BD (eco-globalbd.com) — Apache / LiteSpeed cPanel Configuration
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirect www to non-www (eco-globalbd.com)
  RewriteCond %{HTTP_HOST} ^www\.eco-globalbd\.com$ [NC]
  RewriteRule ^ https://eco-globalbd.com%{REQUEST_URI} [L,R=301]
</IfModule>

# Custom 404 Page
ErrorDocument 404 /404.html

# Correct MIME type for 3D GLB models
<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
  AddType model/gltf+json .gltf
</IfModule>

# Long-term caching for fingerprinted static assets & 3D/image media
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType model/gltf-binary "access plus 30 days"
</IfModule>
